# Monitoring stack environment.
# Generated by Ansible - do not edit directly.
#
# Read by `docker compose` (as root) and handed to the three exporter containers only. Secrets
# below are dummy values in the test environment, where the devices do not exist anyway.

# Device hosts: the AmpliFi router and the Comcast gateway. Blank means "not configured": the exporter
# serves <name>_up 0 and idles.
MONITORING_AMPLIFI_HOST={{ '' if is_test else '10.0.0.1' }}
MONITORING_GATEWAY_HOST={{ '' if is_test else monitoring_gateway_host }}
MONITORING_LAN_IP={{ '' if is_test else private_ip_address }}

# Credentials.
AMPLIFI_PASSWORD={{ 'test-not-a-secret' if is_test else vault_amplifi_password }}
GATEWAY_USERNAME={{ 'test-not-a-secret' if is_test else vault_gateway_username }}
GATEWAY_PASSWORD={{ 'test-not-a-secret' if is_test else vault_gateway_password }}
{# Blank when the gateway is not configured; set from the certificate fetched at deploy time. #}
MONITORING_GATEWAY_TLS_FINGERPRINT_SHA256={{ monitoring_gateway_tls_fingerprint | default("") | trim }}

# Polling intervals in seconds (the AirPlay resolve timeout is in milliseconds). The gateway allows
# a single admin session, so the exporter waits at least
# MONITORING_GATEWAY_RELOGIN_MIN_SECONDS between re-logins rather than evicting a person using the
# gateway's GUI on every poll. The ping settings must match the seeded ping-targets.yml.
MONITORING_AMPLIFI_INTERVAL=30
MONITORING_GATEWAY_INTERVAL=60
MONITORING_GATEWAY_RELOGIN_MIN_SECONDS=300
MONITORING_AIRPLAY_INTERVAL=30
MONITORING_AIRPLAY_RESOLVE_TIMEOUT_MS=3000
MONITORING_PING_INTERVAL={{ monitoring_ping_interval_seconds }}
MONITORING_PING_TIMEOUT={{ monitoring_ping_timeout_seconds }}
MONITORING_PING_HISTORY_SIZE={{ monitoring_ping_history_size }}

# Targets. The tracked-client list (device names and MACs) lives in the vault because this repository
# is public; the test environment gets none.
MONITORING_TRACKED_CLIENTS={{ ([] if is_test else vault_monitoring_tracked_clients) | to_json }}
{# The test instance pings only the public anchors, never the home network's addresses. #}
{% set ping_targets = ['1.1.1.1', '8.8.8.8'] if is_test else monitoring_static_ping_targets %}
MONITORING_STATIC_PING_TARGETS={{ ping_targets | to_json }}
MONITORING_SHARED_DIR=/shared
MONITORING_LOG_LEVEL=INFO
