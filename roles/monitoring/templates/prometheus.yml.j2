# Prometheus configuration. Generated by Ansible; do not edit directly.

global:
  scrape_interval: {{ monitoring_scrape_interval }}
  evaluation_interval: {{ monitoring_evaluation_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:{{ monitoring_alertmanager_port }}

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:{{ monitoring_prometheus_port }}

  # Host-network exporters bind the bridge gateway address.
  - job_name: node
    static_configs:
      - targets:
          - {{ monitoring_docker_gateway }}:{{ monitoring_node_exporter_port }}

  - job_name: ping
    static_configs:
      - targets:
          - {{ monitoring_docker_gateway }}:{{ monitoring_ping_exporter_port }}

  - job_name: airplay
    static_configs:
      - targets:
          - {{ monitoring_docker_gateway }}:{{ monitoring_airplay_exporter_port }}

  # Bridge-network exporters are reached by service name.
  - job_name: amplifi
    static_configs:
      - targets:
          - amplifi_exporter:{{ monitoring_amplifi_exporter_port }}

  - job_name: gateway
    static_configs:
      - targets:
          - gateway_exporter:{{ monitoring_gateway_exporter_port }}

  - job_name: blackbox
    static_configs:
      - targets:
          - blackbox_exporter:{{ monitoring_blackbox_port }}

  # AirPlay TCP port probes; targets are rewritten by the AmpliFi exporter as HomePod addresses change.
  - job_name: airplay_tcp
    metrics_path: /probe
    params:
      module:
        - airplay_tcp
    file_sd_configs:
      - files:
          - /shared/airplay-targets.json
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: blackbox_exporter:{{ monitoring_blackbox_port }}
