# Home Assistant configuration. Generated by Ansible; do not edit directly.
#
# This file is the only part of Home Assistant's configuration that Ansible owns. Integrations,
# pairings, users, areas and helpers are created in the UI and stored by Home Assistant itself under
# `.storage`; see the role's README for the runbook.

default_config:

{% if not homeassistant_http_settings_stored | bool %}
# Home Assistant imports this block on its very first start, keeps the settings in its own storage from
# then on (they are changed under Settings > System > Network), and raises a repair notice for as long
# as the block stays in this file. So it is rendered only until that storage exists; the deploy after
# the first one removes it.
#
# Listening on loopback (for the Apache vhost) and on the monitoring Docker network's gateway address
# (for Prometheus) and nowhere else is what keeps the port off the LAN and off the tailnet: ufw alone
# would not, because Tailscale accepts everything arriving on its interface before ufw is consulted.
# The gateway address is the monitoring role's `monitoring_docker_gateway`.
http:
  server_host:
    - 127.0.0.1
    - 172.28.0.1
  use_x_forwarded_for: true
  trusted_proxies:
    - 127.0.0.1

{% endif %}

# The metrics the monitoring role's Prometheus scrapes, at /api/prometheus. Whole domains only: naming
# entities here would put the household's device names into this repository.
prometheus:
{% if is_test %}
  # The test environment has no user to issue an access token; production requires one.
  requires_auth: false
{% endif %}
  filter:
    include_domains:
      - sensor
      - binary_sensor
      - climate
      - light
      - switch
      - update

# Days of state history kept for Home Assistant's own UI. Short, because Prometheus is where the history
# lives.
recorder:
  purge_keep_days: 3
