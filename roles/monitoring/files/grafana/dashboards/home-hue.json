{
  "id": null,
  "uid": "home-hue",
  "title": "Hue",
  "tags": [
    "home-network"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Bridge software installed",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "expr": "changes(hue_bridge_last_software_install_timestamp_seconds[$__rate_interval]) > 0",
        "titleFormat": "Bridge installed software",
        "useValueForTime": false
      },
      {
        "name": "Zigbee channel changed",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "changes(hue_bridge_zigbee_channel[$__rate_interval]) > 0",
        "titleFormat": "Zigbee channel changed",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bridge reachable (hue_up)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hue_up"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Zigbee channel",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hue_bridge_zigbee_channel"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lights on",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(hue_light_on == 1) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Devices not connected to Zigbee",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(hue_zigbee_connectivity{status=\"connected\"} == 0) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cloud services (internet, remote access, time, software updates)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hue_bridge_internet_connected",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disconnected",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "Connected",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Zigbee connectivity per device (a lamp switched off at the wall reads not connected)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hue_zigbee_connectivity{status=\"connected\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not connected",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Connected",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Not connected now",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (device_id, name, status) (hue_zigbee_connectivity{status!=\"connected\"} == 1) * on (device_id) group_left (room) max by (device_id, room) (hue_device_info)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "device_id": true
            },
            "indexByName": {
              "name": 0,
              "room": 1,
              "status": 2
            },
            "renameByName": {
              "name": "Device",
              "room": "Room",
              "status": "Zigbee status"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Devices",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (device_id, name, product, model, software_version, room) (hue_device_info)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "device_id": true
            },
            "indexByName": {
              "name": 0,
              "room": 1,
              "product": 2,
              "model": 3,
              "software_version": 4
            },
            "renameByName": {
              "name": "Device",
              "room": "Room",
              "product": "Product",
              "model": "Model",
              "software_version": "Software"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Room"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Lights on and off",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hue_light_on",
          "legendFormat": "{{name}}"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Off",
                  "color": "dark-blue",
                  "index": 0
                },
                "1": {
                  "text": "On",
                  "color": "yellow",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Battery",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hue_device_battery_ratio",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "text",
      "title": "Why HomeKit accessories are on a Hue dashboard",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "Siri and the Home app reach the Hue lights through HomeKit: a request goes to the home hub (an Apple TV or HomePod), which talks to the bridge as a HomeKit accessory. So when \"the lights stopped responding\", the question is as often the hub or the network as the bridge, and the HomeKit accessories table below is the only record of that side. Read it alongside the Hue panels above: was the bridge (`Philips Hue HomeKit`) still present and paired at the time; were the hub candidates (the HomePod sensors here are the HomePods themselves, named in the Device column) present; did other accessories drop off at the same moment, which points at the network rather than the bridge; and did the bridge's address change just before (the `homekit_accessory_address_info` series). Presence is read passively from the accessories' own mDNS announcements, so a disappearance shows up to 75 minutes late and a return shows as soon as the accessory announces."
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "HomeKit accessories on the LAN (presence from their mDNS announcements; Device is the address inventory's name for the device at that address: a tracked client, else the router's name, which the AmpliFi app can set)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (accessory, device, model, category) (homekit_accessory_info) * on (accessory) group_left () homekit_accessory_present",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (accessory) (homekit_accessory_paired)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "accessory": 0,
              "device": 1,
              "model": 2,
              "category": 3,
              "Value #A": 4,
              "Value #B": 5
            },
            "renameByName": {
              "accessory": "Accessory",
              "device": "Device",
              "model": "Model",
              "category": "Category",
              "Value #A": "Present",
              "Value #B": "Paired"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Accessory"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "index": 0
                },
                "1": {
                  "text": "Yes",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 15,
      "collapsed": true,
      "title": "Hue sensors (temperature, light level, motion): empty unless the bridge has a motion sensor",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 53
      },
      "panels": [
        {
          "id": 10,
          "type": "timeseries",
          "title": "Sensor temperature",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 54
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "hue_sensor_temperature_celsius",
              "legendFormat": "{{name}}",
              "format": "time_series",
              "range": true,
              "instant": false
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "celsius"
            },
            "overrides": []
          }
        },
        {
          "id": 11,
          "type": "timeseries",
          "title": "Sensor light level (lux, log scale)",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 54
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "hue_sensor_light_level_lux",
              "legendFormat": "{{name}}",
              "format": "time_series",
              "range": true,
              "instant": false
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "lux",
              "custom": {
                "scaleDistribution": {
                  "type": "log",
                  "log": 10
                }
              }
            },
            "overrides": []
          }
        },
        {
          "id": 12,
          "type": "state-timeline",
          "title": "Motion",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 54
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "hue_sensor_motion",
              "legendFormat": "{{name}}",
              "format": "time_series",
              "range": true,
              "instant": false
            }
          ],
          "options": {
            "mergeValues": true,
            "showValue": "never",
            "rowHeight": 0.8,
            "legend": {
              "showLegend": false,
              "displayMode": "list",
              "placement": "bottom",
              "calcs": []
            },
            "tooltip": {
              "mode": "single",
              "sort": "none"
            }
          },
          "fieldConfig": {
            "defaults": {
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "Still",
                      "color": "dark-blue",
                      "index": 0
                    },
                    "1": {
                      "text": "Motion",
                      "color": "orange",
                      "index": 1
                    }
                  }
                }
              ]
            },
            "overrides": []
          }
        }
      ]
    }
  ]
}
