# The AmpliFi router's admin password. Generated by Ansible - do not edit directly.
#
# Read by `docker compose` (as root) and handed only to the AmpliFi scraper. A dummy value in the test
# environment, where the router does not exist. Compose's env-file parser expands `$VAR` in unquoted
# values, so a literal dollar sign must be written as `$$` (quoting is no help: a quote inside the
# value would end it).
AMPLIFI_PASSWORD={{ 'test-not-a-secret' if is_test else vault_amplifi_password | replace('$', '$$') }}
