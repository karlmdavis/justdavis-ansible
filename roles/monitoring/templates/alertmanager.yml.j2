# Alertmanager configuration. Generated by Ansible; do not edit directly.
#
# Webhook URLs are read from files (not embedded here) so this file holds no secrets. In the test
# environment everything routes to a null receiver.

{# Go template delimiters, spelled via variables because Ansible's Jinja trims the newline after
   an inline raw block. #}
{% set L = '{{' %}
{% set R = '}}' %}
global:
  resolve_timeout: 5m

route:
  receiver: '{{ 'null' if is_test else 'home' }}'
  group_by:
    - alertname
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
{% if is_test %}
  - name: 'null'
{% else %}
  - name: home
    slack_configs:
      - api_url_file: /secrets/slack_webhook_url
        send_resolved: true
        title: '[{{ L }} .Status | toUpper {{ R }}] {{ L }} .CommonLabels.alertname {{ R }}'
        text: >-
          {{ L }} range .Alerts {{ R }}{{ L }} .Annotations.summary {{ R }}{{ L }} "\n" {{ R }}{{ L }}
          end {{ R }}
    discord_configs:
      - webhook_url_file: /secrets/discord_webhook_url
        send_resolved: true
        title: '[{{ L }} .Status | toUpper {{ R }}] {{ L }} .CommonLabels.alertname {{ R }}'
        message: >-
          {{ L }} range .Alerts {{ R }}{{ L }} .Annotations.summary {{ R }}{{ L }} "\n" {{ R }}{{ L }}
          end {{ R }}
{% endif %}
