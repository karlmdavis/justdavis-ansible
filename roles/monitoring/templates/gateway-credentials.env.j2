# The Comcast gateway's admin credentials. Generated by Ansible - do not edit directly.
#
# Read by `docker compose` (as root) and handed only to the gateway scraper. Dummy values in the test
# environment, where the gateway does not exist. Compose's env-file parser expands `$VAR` in unquoted
# values, so a literal dollar sign must be written as `$$` (quoting is no help: a quote inside the
# value would end it).
GATEWAY_USERNAME={{ 'test-not-a-secret' if is_test else vault_gateway_username | replace('$', '$$') }}
GATEWAY_PASSWORD={{ 'test-not-a-secret' if is_test else vault_gateway_password | replace('$', '$$') }}
