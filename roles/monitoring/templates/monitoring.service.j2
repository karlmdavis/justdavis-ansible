[Unit]
Description=Home Network Monitoring (Prometheus, Grafana, Alertmanager, exporters)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
WorkingDirectory={{ monitoring_base_dir }}
Type=simple
# No --build/--pull here on purpose: images are built and pulled by Ansible handlers during deploys, so
# a restart during a WAN outage (exactly when this stack matters most) depends on nothing remote.
ExecStart=/usr/bin/docker compose up --remove-orphans
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
