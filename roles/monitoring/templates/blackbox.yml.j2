# Blackbox exporter configuration. Generated by Ansible; do not edit directly.

modules:
  # Connects to a HomePod's AirPlay port (7000) and closes immediately. Separates "the HomePod answers
  # ping but its AirPlay service is wedged" from radio problems.
  airplay_tcp:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4
