# Prometheus recording rules. Generated by Ansible; do not edit directly.
#
# Derived series that the dashboards read and that a future alert could use. Thresholds are set at the
# top of the template (roles/monitoring/templates/recording.yml.j2) with the observations they rest on.

{# Whether a HomePod is playing audio, read from its download rate. Observed 2026-09-23/24 (30-second
   samples of the AmpliFi client byte counters): AirPlay from a phone or iPad holds 60-450 kbit/s per
   HomePod, with every member of a group moving in lockstep; Apple Music playing on the HomePods
   themselves fetches per track, 25 kbit/s to 1.4 Mbit/s with a ~500 kbit/s mean, and the overnight
   bedtime playlist (Apple Music, music, all night) held a steady 50-90 kbit/s; an idle HomePod sits at
   0-20 kbit/s. 40 kbit/s separates audio from idle, and a 3-minute average rides over Apple Music's
   between-track lulls. Open question, dated 2026-09-24: 50-90 kbit/s is far below 256 kbit/s AAC, so
   either a low-quality setting or something else is at work; unverified. #}
{% set audio_active_bits_per_second = 40000 %}
groups:
  # Evaluated every 30 s, the same as the alert rules, so `offset 30s` below is exactly one evaluation.
  - name: homepod_audio
    interval: 30s
    rules:
      # Download rate per HomePod. Summed by name so the series survives a roam, which restarts the
      # router's per-association counters (the exporter folds them into one series per client, but the
      # sum costs nothing and keeps the rule correct if that ever changes).
      - record: homepod:download_bits_per_second:rate1m
        expr: sum by (name) (rate(amplifi_client_rx_bytes_total{kind="homepod"}[1m])) * 8

      # 1 while audio is playing to the HomePod, 0 otherwise.
      - record: homepod:audio_active
        expr: >-
          avg_over_time(homepod:download_bits_per_second:rate1m[3m])
          >bool {{ audio_active_bits_per_second }}

      # 1 at the one evaluation where audio stopped while the HomePod stayed on the WiFi: a point event
      # for dashboard annotations, not a state. A HomePod that left the WiFi is `HomePodNotOnWifi`'s
      # business, so the join with the association gauge (labels: mac, name, kind) is by name only.
      - record: homepod:audio_ended
        expr: >-
          (homepod:audio_active == 0)
          and on (name) (homepod:audio_active offset 30s == 1)
          and on (name) (amplifi_tracked_client_associated{kind="homepod"} == 1)
