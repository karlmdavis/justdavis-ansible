# Credentials for the AmpliFi router and the Comcast gateway.
# Generated by Ansible - do not edit directly.
#
# Read by `docker compose` (as root) and handed only to the two device scrapers; the host-network
# AirPlay probe never sees them. Dummy values in the test environment, where the devices do not exist.
#
# Compose's env-file parser expands `$VAR` in unquoted values, so a literal dollar sign must be written
# as `$$` (quoting is no help: a quote inside the value would end it).
AMPLIFI_PASSWORD={{ 'test-not-a-secret' if is_test else vault_amplifi_password | replace('$', '$$') }}
GATEWAY_USERNAME={{ 'test-not-a-secret' if is_test else vault_gateway_username | replace('$', '$$') }}
GATEWAY_PASSWORD={{ 'test-not-a-secret' if is_test else vault_gateway_password | replace('$', '$$') }}
