{
  "id": null,
  "uid": "wifi-homepods",
  "title": "WiFi & HomePods",
  "tags": ["home-network"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "annotations": {
    "list": [
      {
        "name": "Audio stopped",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "expr": "max_over_time(homepod:audio_ended[$__interval]) == 1",
        "titleFormat": "{{name}}: audio stopped",
        "useValueForTime": false
      },
      {
        "name": "Left a playing group",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "max_over_time(homepod:left_playing_group[$__interval]) == 1",
        "titleFormat": "{{name}}: left a group that kept playing",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "HomePod mesh point, band and SSID (each row is one association; a row ending means it moved or changed SSID)",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "amplifi_client_info{kind=\"homepod\"}",
          "legendFormat": "{{airplay_name}} · {{ap_name}} · {{band}} · {{network}}"
        }
      ],
      "transformations": [
        {"id": "renameByRegex", "options": {"regex": "(.*) · User network$", "renamePattern": "$1 · main SSID"}},
        {"id": "renameByRegex", "options": {"regex": "(.*) · Device specific network$", "renamePattern": "$1 · extra SSID"}},
        {"id": "renameByRegex", "options": {"regex": "(.*) · Guest network$", "renamePattern": "$1 · guest SSID"}}
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8,
        "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {"1": {"text": "Associated", "color": "green", "index": 0}}}]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HomePod signal quality (router-reported, 0-100)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "amplifi_client_signal_quality{kind=\"homepod\"} * on (mac) group_left (airplay_name) max by (mac, airplay_name) (amplifi_client_info{kind=\"homepod\"})",
          "legendFormat": "{{airplay_name}}"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "none"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HomePod ping: mean round trip",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "ping_rtt_mean_seconds * on (ip) group_left (airplay_name, kind) monitoring_target_info{kind=\"homepod\"}",
          "legendFormat": "{{airplay_name}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HomePod ping: packet loss",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "ping_loss_ratio * on (ip) group_left (airplay_name, kind) monitoring_target_info{kind=\"homepod\"}",
          "legendFormat": "{{airplay_name}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HomePod ping: jitter (standard deviation)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "ping_rtt_std_deviation_seconds * on (ip) group_left (airplay_name, kind) monitoring_target_info{kind=\"homepod\"}",
          "legendFormat": "{{airplay_name}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "AirPlay reachability: mDNS resolves by multicast, by unicast to the HomePod, and TCP port 7000 accepts",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "airplay_service_resolved{service=\"_airplay._tcp\"}", "legendFormat": "{{name}}: mDNS multicast"},
        {"refId": "C", "expr": "airplay_service_unicast_resolved{service=\"_airplay._tcp\"}", "legendFormat": "{{name}}: mDNS unicast"},
        {"refId": "B", "expr": "probe_success{job=\"airplay_tcp\"}", "legendFormat": "{{airplay_name}}: port 7000"}
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8,
        "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "Failed", "color": "red", "index": 0},
                "1": {"text": "OK", "color": "green", "index": 1}
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "What each HomePod is doing: grey silent, green playing its own stream, yellow following another device but silent, blue following and playing; a gap is no reading",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 40},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "homepod:session_state", "legendFormat": "{{name}}"}
      ],
      "options": {"mergeValues": true, "showValue": "never", "rowHeight": 0.8, "legend": {"displayMode": "hidden"}},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "Silent, not following another device", "color": "#5a5f66", "index": 0},
                "1": {"text": "Playing its own stream", "color": "green", "index": 1},
                "2": {"text": "Following another device, silent", "color": "yellow", "index": 2},
                "3": {"text": "Following another device, playing", "color": "blue", "index": 3}
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Groups now: HomePods with the same group are grouped; the last column is 1 where audio is playing",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 49},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "airplay_group_info * on (name) group_left () airplay_audio_playing",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "instance": true, "job": true},
            "indexByName": {"group": 0, "name": 1, "Value": 2},
            "renameByName": {"group": "Group", "name": "HomePod", "Value": "Audio playing"}
          }
        },
        {"id": "sortBy", "options": {"sort": [{"field": "Group"}]}}
      ],
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HomePod download rate, where the router reports byte counts",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 57},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "homepod:download_bits_per_second:rate1m * on (name) group_left (airplay_name) max by (name, airplay_name) (amplifi_client_info{kind=\"homepod\"})",
          "legendFormat": "{{airplay_name}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bps", "min": 0}, "overrides": []}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Mesh point backhaul minimum RSSI",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 65},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "amplifi_mesh_point_rssi_min_dbm", "legendFormat": "{{name}}"}],
      "fieldConfig": {"defaults": {"unit": "dBm"}, "overrides": []}
    },
    {
      "id": 8,
      "type": "table",
      "title": "Mesh points",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 65},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "max by (mac, name, backhaul_band, platform, uplink, level) (amplifi_mesh_point_info)",
          "format": "table",
          "instant": true
        },
        {"refId": "B", "expr": "max by (mac, name) (amplifi_mesh_point_online)", "format": "table", "instant": true},
        {"refId": "C", "expr": "max by (mac, name) (amplifi_mesh_point_uptime_seconds)", "format": "table", "instant": true}
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "Value #A": true, "platform": true},
            "indexByName": {
              "name": 0,
              "uplink": 1,
              "level": 2,
              "backhaul_band": 3,
              "Value #B": 4,
              "Value #C": 5,
              "mac": 6
            },
            "renameByName": {"Value #B": "online", "Value #C": "uptime"}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [{"matcher": {"id": "byName", "options": "uptime"}, "properties": [{"id": "unit", "value": "s"}]}]
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Every WiFi client: signal quality (untracked devices shown by MAC)",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 73},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "amplifi_client_signal_quality{kind!=\"backhaul\"}", "legendFormat": "{{name}} {{mac}} ({{kind}})"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 100}, "overrides": []}
    }
  ]
}
