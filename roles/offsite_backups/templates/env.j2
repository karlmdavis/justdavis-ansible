# Environment for restic, loaded by the offsite-backups systemd units and by `offsite-restic`.
# Managed by Ansible (roles/offsite_backups); root-only because it holds credentials.
RESTIC_REPOSITORY={{ offsite_backups_repository }}
RESTIC_PASSWORD={{ offsite_backups_restic_password }}
RESTIC_CACHE_DIR=/var/cache/restic
RESTIC_COMPRESSION=auto
{% if offsite_backups_b2_key_id %}
B2_ACCOUNT_ID={{ offsite_backups_b2_key_id }}
B2_ACCOUNT_KEY={{ offsite_backups_b2_key }}
{% endif %}
