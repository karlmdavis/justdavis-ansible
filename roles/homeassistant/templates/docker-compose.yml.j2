##

name: homeassistant

services:
  homeassistant:
    image: {{ homeassistant_image }}
    # Host networking: HomeKit and mDNS discovery need the LAN's multicast. Which addresses the web
    # server listens on is Home Assistant's own setting; see configuration.yaml.j2 and the README.
    network_mode: host
    # No capabilities and no privileged mode: nothing here uses Bluetooth, USB or raw sockets. The one
    # thing this costs is DHCP-based device discovery, which logs "Cannot watch for dhcp packets" once
    # at start.
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    volumes:
      - {{ homeassistant_base_dir }}/config:/config
      - /etc/localtime:/etc/localtime:ro
    # A hard stop on a leak; an idle instance with no integrations uses about 450 MiB.
    mem_limit: 2g
    stop_grace_period: 60s
    restart: unless-stopped
