# Alertmanager configuration. Generated by Ansible; do not edit directly.
#
# Credentials (the Slack bot token and the Discord webhook URL) are read from files, not embedded
# here, so this file holds no secrets. Slack is posted to through the Web API with a bot token
# (the "Home Monitoring" app); Discord through a channel webhook. In the test environment
# everything routes to a null receiver.

{# Go template delimiters, spelled via variables because Ansible's Jinja trims the newline after
   an inline raw block. #}
{% set L = '{{' %}
{% set R = '}}' %}
global:
  resolve_timeout: 5m

route:
  receiver: '{{ 'null' if is_test else 'home' }}'
  group_by:
    - alertname
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
{% if is_test %}
  - name: 'null'
{% else %}
  - name: home
    slack_configs:
      - api_url: https://slack.com/api/chat.postMessage
        http_config:
          authorization:
            credentials_file: /secrets/slack_bot_token
        # The private #home-alerts channel, by ID (names are unreliable for private channels).
        channel: 'C0C1CB8DUE7'
        send_resolved: true
        title: '[{{ L }} .Status | toUpper {{ R }}] {{ L }} .CommonLabels.alertname {{ R }}'
        text: >-
          {{ L }} range .Alerts {{ R }}{{ L }} .Annotations.summary {{ R }}{{ L }} "\n" {{ R }}{{ L }}
          end {{ R }}
    discord_configs:
      - webhook_url_file: /secrets/discord_webhook_url
        send_resolved: true
        title: '[{{ L }} .Status | toUpper {{ R }}] {{ L }} .CommonLabels.alertname {{ R }}'
        message: >-
          {{ L }} range .Alerts {{ R }}{{ L }} .Annotations.summary {{ R }}{{ L }} "\n" {{ R }}{{ L }}
          end {{ R }}
{% endif %}
