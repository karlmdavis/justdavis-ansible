##
# Home network monitoring stack. Generated by Ansible; do not edit directly.
#
# Networking: bridge-network services talk to each other by name and publish only on 127.0.0.1; the
# services that need the host's network stack (node_exporter, ping_exporter, airplay_exporter) bind
# their metrics endpoints to the bridge gateway address so Prometheus can reach them without anything
# being exposed on the LAN. Grafana is reached through the Apache TLS proxy.
##

name: monitoring

networks:
  default:
    name: {{ monitoring_docker_network }}
    external: true

x-hardened: &hardened
  read_only: true
  cap_drop:
    - ALL
  security_opt:
    - no-new-privileges:true
  tmpfs:
    - /tmp
  restart: unless-stopped

x-exporter: &exporter
  <<: *hardened
  image: {{ monitoring_exporters_image }}
  build:
    context: ./exporters
  env_file:
    - .env
  user: "{{ monitoring_uid }}:{{ monitoring_gid }}"

services:
  prometheus:
    <<: *hardened
    image: {{ monitoring_prometheus_image }}
    user: "{{ monitoring_uid }}:{{ monitoring_gid }}"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.size={{ monitoring_prometheus_retention_size }}
      - --web.listen-address=0.0.0.0:{{ monitoring_prometheus_port }}
    volumes:
      - {{ monitoring_base_dir }}/prometheus:/etc/prometheus:ro
      - {{ monitoring_base_dir }}/shared:/shared:ro
      - {{ monitoring_base_dir }}/data/prometheus:/prometheus
    ports:
      - "127.0.0.1:{{ monitoring_prometheus_port }}:{{ monitoring_prometheus_port }}"
    mem_limit: {{ monitoring_prometheus_mem_limit }}

  grafana:
    <<: *hardened
    image: {{ monitoring_grafana_image }}
    user: "{{ monitoring_uid }}:{{ monitoring_gid }}"
    env_file:
      - .env
    environment:
      GF_SECURITY_ADMIN_PASSWORD__FILE: /secrets/grafana_admin_password
      GF_PATHS_PROVISIONING: /etc/grafana/provisioning
      GF_LOG_MODE: console
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_USERS_ALLOW_ORG_CREATE: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_AUTH_BASIC_ENABLED: "false"
      GF_SECURITY_COOKIE_SECURE: "true"
      GF_SECURITY_STRICT_TRANSPORT_SECURITY: "true"
      GF_SECURITY_DISABLE_GRAVATAR: "true"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_FEEDBACK_LINKS_ENABLED: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_SNAPSHOTS_EXTERNAL_ENABLED: "false"
      GF_METRICS_ENABLED: "false"
    volumes:
      - {{ monitoring_base_dir }}/grafana/provisioning:/etc/grafana/provisioning:ro
      - {{ monitoring_base_dir }}/grafana/dashboards:/var/lib/grafana-dashboards:ro
      - {{ monitoring_base_dir }}/secrets/grafana_admin_password:/secrets/grafana_admin_password:ro
      - {{ monitoring_base_dir }}/data/grafana:/var/lib/grafana
    ports:
      - "127.0.0.1:{{ monitoring_grafana_port }}:{{ monitoring_grafana_port }}"
    mem_limit: {{ monitoring_grafana_mem_limit }}

  alertmanager:
    <<: *hardened
    image: {{ monitoring_alertmanager_image }}
    user: "{{ monitoring_uid }}:{{ monitoring_gid }}"
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --web.listen-address=0.0.0.0:{{ monitoring_alertmanager_port }}
    volumes:
      - {{ monitoring_base_dir }}/alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - {{ monitoring_base_dir }}/secrets/slack_webhook_url:/secrets/slack_webhook_url:ro
      - {{ monitoring_base_dir }}/secrets/discord_webhook_url:/secrets/discord_webhook_url:ro
      - {{ monitoring_base_dir }}/data/alertmanager:/alertmanager
    ports:
      - "127.0.0.1:{{ monitoring_alertmanager_port }}:{{ monitoring_alertmanager_port }}"

  blackbox_exporter:
    <<: *hardened
    image: {{ monitoring_blackbox_image }}
    user: "{{ monitoring_uid }}:{{ monitoring_gid }}"
    command:
      - --config.file=/config/blackbox.yml
      - --web.listen-address=0.0.0.0:{{ monitoring_blackbox_port }}
    volumes:
      - {{ monitoring_base_dir }}/blackbox:/config:ro

  amplifi_exporter:
    <<: *exporter
    command:
      - amplifi-exporter
    environment:
      MONITORING_LISTEN_ADDR: 0.0.0.0
      MONITORING_AMPLIFI_PORT: "{{ monitoring_amplifi_exporter_port }}"
    volumes:
      - {{ monitoring_base_dir }}/shared:/shared
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request as u; u.urlopen('http://127.0.0.1:{{ monitoring_amplifi_exporter_port }}/metrics', timeout=3)"
      interval: 60s
      timeout: 5s
      retries: 3

  gateway_exporter:
    <<: *exporter
    command:
      - gateway-exporter
    environment:
      MONITORING_LISTEN_ADDR: 0.0.0.0
      MONITORING_GATEWAY_PORT: "{{ monitoring_gateway_exporter_port }}"
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request as u; u.urlopen('http://127.0.0.1:{{ monitoring_gateway_exporter_port }}/metrics', timeout=3)"
      interval: 60s
      timeout: 5s
      retries: 3

  # mDNS needs the LAN's multicast domain, hence host networking.
  airplay_exporter:
    <<: *exporter
    network_mode: host
    command:
      - airplay-exporter
    environment:
      MONITORING_LISTEN_ADDR: {{ monitoring_docker_gateway }}
      MONITORING_AIRPLAY_PORT: "{{ monitoring_airplay_exporter_port }}"
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request as u; u.urlopen('http://{{ monitoring_docker_gateway }}:{{ monitoring_airplay_exporter_port }}/metrics', timeout=3)"
      interval: 60s
      timeout: 5s
      retries: 3

  # ICMP from the host's own network stack; the binary carries the cap_net_raw file capability, which
  # `no-new-privileges` would block, so this service does not use the hardened anchor. The image has no
  # entrypoint (its CMD runs the binary through a shell), hence the explicit entrypoint here.
  ping_exporter:
    image: {{ monitoring_ping_exporter_image }}
    network_mode: host
    user: "{{ monitoring_uid }}:{{ monitoring_gid }}"
    read_only: true
    cap_drop:
      - ALL
    cap_add:
      - NET_RAW
    restart: unless-stopped
    entrypoint:
      - /app/ping_exporter
    command:
      - --config.path=/shared/ping-targets.yml
      - --web.listen-address={{ monitoring_docker_gateway }}:{{ monitoring_ping_exporter_port }}
    volumes:
      - {{ monitoring_base_dir }}/shared:/shared:ro

  # Host metrics, including the br-wan/br-lan interface counters that the WAN dashboard correlates
  # with latency. Runs as the image's unprivileged user.
  node_exporter:
    <<: *hardened
    image: {{ monitoring_node_exporter_image }}
    network_mode: host
    pid: host
    command:
      - --path.rootfs=/host
      - --web.listen-address={{ monitoring_docker_gateway }}:{{ monitoring_node_exporter_port }}
      - --collector.disable-defaults
      - --collector.cpu
      - --collector.meminfo
      - --collector.loadavg
      - --collector.filesystem
      - --collector.netdev
      - --collector.netdev.device-exclude=^(veth.*|docker.*|br-[0-9a-f]{12}|vnet.*|tailscale.*|lo)$
      - --collector.filesystem.mount-points-exclude=^/(dev|proc|run|sys|var/lib/docker/.+|host/(dev|proc|run|sys|var/lib/docker/.+))($|/)
    volumes:
      - /:/host:ro,rslave
