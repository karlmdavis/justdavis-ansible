[Unit]
Description=Offsite Backups - Retention Prune
OnFailure=status-email-root@%n.service

[Service]
Type=oneshot
TimeoutStartSec=12h
EnvironmentFile=/etc/offsite-backups/restic.env
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/bin/flock --wait 7200 /run/lock/offsite-backups.lock /usr/local/bin/offsite-backups-prune.sh
User=root
