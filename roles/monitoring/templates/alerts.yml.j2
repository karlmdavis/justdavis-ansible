# Prometheus alert rules. Generated by Ansible; do not edit directly.
#
# Thresholds come from role variables (see defaults/main.yml and README.md). Device-specific rule groups
# are omitted in the test environment, where the devices do not exist and would all be "down".

{# Go template delimiters, spelled via variables because Ansible's Jinja trims the newline after
   an inline raw block. #}
{% set L = '{{' %}
{% set R = '}}' %}
groups:
  - name: collectors
    rules:
      - alert: CollectorDown
        expr: up == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Scrape target {{ L }} $labels.job {{ R }} ({{ L }} $labels.instance {{ R }}) is down"

      # A scrape loop that stops returning keeps its last `_up 1`; catch that by staleness.
      - alert: AmpliFiExporterStalled
        expr: amplifi_up == 1 and time() - amplifi_last_success_timestamp_seconds > 600
        labels:
          severity: warning
        annotations:
          summary: "The AmpliFi exporter has not completed a poll in 10 minutes"

      - alert: GatewayExporterStalled
        expr: gateway_up == 1 and time() - gateway_last_success_timestamp_seconds > 900
        labels:
          severity: warning
        annotations:
          summary: "The gateway exporter has not completed a poll in 15 minutes"

      - alert: AirPlayProbeStalled
        expr: airplay_up == 1 and time() - airplay_last_success_timestamp_seconds > 600
        labels:
          severity: warning
        annotations:
          summary: "The AirPlay mDNS probe has not completed a poll in 10 minutes"

  - name: wan
    rules:
      - alert: WanPacketLoss
        expr: >-
          avg_over_time(ping_loss_ratio{target="{{ monitoring_wan_probe_target }}"}[5m])
          > {{ monitoring_alert_wan_loss_ratio }}
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: >-
            WAN packet loss to {{ L }} $labels.target {{ R }} is {{ L }} $value | humanizePercentage {{ R }}

      - alert: WanLatencyHigh
        expr: >-
          ping_rtt_mean_seconds{target="{{ monitoring_wan_probe_target }}"}
          > {{ monitoring_alert_wan_latency_seconds }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: >-
            WAN round-trip to {{ L }} $labels.target {{ R }} is {{ L }} $value | humanizeDuration {{ R }}

      - alert: WanJitterHigh
        expr: >-
          ping_rtt_std_deviation_seconds{target="{{ monitoring_wan_probe_target }}"}
          > {{ monitoring_alert_wan_jitter_seconds }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "WAN jitter to {{ L }} $labels.target {{ R }} is {{ L }} $value | humanizeDuration {{ R }}"
{% if not is_test %}

  - name: homepods
    rules:
      - alert: HomePodUnreachable
        expr: >-
          (ping_loss_ratio * on (ip) group_left (name, kind) monitoring_target_info{kind="homepod"}) == 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "HomePod {{ L }} $labels.name {{ R }} ({{ L }} $labels.ip {{ R }}) is not answering ping"

      - alert: HomePodAirPlayPortDown
        expr: probe_success{job="airplay_tcp"} == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "HomePod {{ L }} $labels.name {{ R }} is not accepting AirPlay connections"

      - alert: HomePodAirPlayNotResolving
        expr: airplay_service_resolved{service="_airplay._tcp"} == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "HomePod {{ L }} $labels.name {{ R }} does not answer AirPlay mDNS queries"

  - name: amplifi
    rules:
      - alert: AmpliFiRebooted
        expr: amplifi_router_uptime_seconds < {{ monitoring_alert_reboot_uptime_seconds }}
        labels:
          severity: info
        annotations:
          summary: "The AmpliFi router rebooted"

      - alert: MeshPointRebooted
        expr: amplifi_mesh_point_uptime_seconds < {{ monitoring_alert_reboot_uptime_seconds }}
        labels:
          severity: info
        annotations:
          summary: "Mesh point {{ L }} $labels.name {{ R }} rebooted"

      - alert: MeshPointMissing
        expr: >-
          ((count(amplifi_mesh_point_info) or vector(0)) < {{ monitoring_amplifi_mesh_point_count }})
          and on () amplifi_up == 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "A mesh point has disappeared from the AmpliFi topology"

      - alert: AirPlayProbeFailing
        expr: airplay_up == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "The AirPlay mDNS probe is not running (check MONITORING_LAN_IP and host networking)"

      - alert: AmpliFiScrapeFailing
        expr: amplifi_up == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "The AmpliFi exporter cannot read the router"

  - name: gateway
    rules:
      - alert: GatewayRebooted
        expr: gateway_uptime_seconds < {{ monitoring_alert_reboot_uptime_seconds }}
        labels:
          severity: info
        annotations:
          summary: "The Comcast gateway rebooted"

      - alert: GatewayInternetInactive
        expr: gateway_internet_active == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "The Comcast gateway reports the Internet connection as inactive"

      - alert: DocsisUncorrectableCodewords
        expr: rate(gateway_docsis_downstream_uncorrectable_codewords_total[5m]) > 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Downstream channel {{ L }} $labels.channel {{ R }} is seeing uncorrectable codewords"

      - alert: DocsisUncorrectableCodewordsBurst
        expr: >-
          increase(gateway_docsis_downstream_uncorrectable_codewords_total[15m])
          > {{ monitoring_alert_docsis_uncorrectable_increase_15m }}
        labels:
          severity: critical
        annotations:
          summary: >-
            Downstream channel {{ L }} $labels.channel {{ R }}: {{ L }} $value | humanize {{ R }}
            uncorrectable codewords in 15m

      - alert: DocsisSnrLow
        expr: gateway_docsis_downstream_snr_db < {{ monitoring_alert_docsis_snr_min_db }}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Downstream channel {{ L }} $labels.channel {{ R }} SNR is {{ L }} $value {{ R }} dB"

      - alert: DocsisPowerOutOfRange
        expr: >-
          gateway_docsis_downstream_power_dbmv > {{ monitoring_alert_docsis_power_max_dbmv }}
          or gateway_docsis_downstream_power_dbmv < {{ monitoring_alert_docsis_power_min_dbmv }}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Downstream channel {{ L }} $labels.channel {{ R }} power is {{ L }} $value {{ R }} dBmV"

      - alert: GatewayScrapeFailing
        expr: gateway_up == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "The gateway exporter cannot read the Comcast gateway"
{% endif %}
