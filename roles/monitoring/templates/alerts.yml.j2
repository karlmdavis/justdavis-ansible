# Prometheus alert rules. Generated by Ansible; do not edit directly.
#
# Thresholds are set at the top of the template (roles/monitoring/templates/alerts.yml.j2) with the
# guidance they follow. Device-specific rule groups are omitted in the test environment, where the
# devices do not exist and would all be "down".

{# Go template delimiters, spelled via variables because Ansible's Jinja trims the newline after
   an inline raw block. #}
{% set L = '{{' %}
{% set R = '}}' %}
{# The ping target whose loss, latency, and jitter stand for "the internet". #}
{% set wan_target = '1.1.1.1' %}
{# Video-conferencing guidance: calls degrade above roughly 5% loss, 100 ms round trip, 30 ms jitter. #}
{% set wan_loss_ratio = 0.05 %}
{% set wan_latency_seconds = 0.1 %}
{% set wan_jitter_seconds = 0.03 %}
{# DOCSIS guidance: SNR below 33 dB is a line problem, and the rule uses that figure as is. Downstream
   power has two figures: the ideal range is -7..+7 dBmV, and the receiver's specified input range is
   -15..+15 dBmV. This plant reads +10 to +13.5 dBmV (September 2026; hottest on the 381-441 MHz
   channels, ~1.5 dB higher overnight than by day), i.e. 3 to 6.5 dB above the ideal ceiling, with
   43-45 dB SNR and no uncorrectable codewords, so the excess costs nothing measurable. The rule
   therefore alerts at the spec limit, and the gap to the ideal is a data point for a call to Comcast,
   not an alert. #}
{% set docsis_snr_min_db = 33 %}
{% set docsis_power_min_dbmv = -15 %}
{% set docsis_power_max_dbmv = 15 %}
{# Uncorrectable codewords are judged as a share of the channel's codewords over 15 minutes, not as a
   count. An OFDM channel carries ~16,000 codewords a second and a QAM channel ~2,000 (2026-09-24), so
   the first rules ("any" for 5 minutes, warning; 1,000 in 15 minutes, critical) fired on episodes of
   0.02% loss confined to the two OFDM channels, with 0% WAN packet loss.
   Both thresholds are a first estimate: no episode here has yet coincided with trouble anyone
   noticed, so there is no local incident to calibrate against. The warning at 1% is the rule of thumb
   in cable field guidance (for example the Volpe Firm's "DOCSIS Codeword Errors"): below it, real-time
   traffic such as voice and video calls is not expected to suffer. The critical at 5% has no source
   beyond being well past that line. For scale, the worst 15 minutes in the first five days
   (2026-09-23 to 09-27) was 0.26% on one OFDM channel, with 0% WAN ping loss and every other channel
   under 0.01%; ping is a blunt check, though, since 60 probes a minute cannot show a loss that small
   on one bonded channel. Revisit both when an episode does line up with a real problem. The counters
   are still recorded and charted, so smaller episodes stay visible without a notification. #}
{% set docsis_uncorrectable_share = 0.01 %}
{% set docsis_uncorrectable_share_severe = 0.05 %}
{# A failed gateway scrape leaves a two-to-three-minute hole in every DOCSIS series while the
   exporter backs off, and a hole resets a rule's `for` clock, so the channel rules keep firing across
   one instead of resolving and re-firing. (On the first night, 2026-09-23, six scrapes failed: four
   read timeouts waiting for the page and two half-rendered pages; whether that continues is for the
   logs to say.) #}
{% set docsis_keep_firing_for = '15m' %}
{# Uptime below this means the device rebooted in the last ten minutes: long enough for the rule to be
   evaluated and the alert delivered, short enough that it does not linger. #}
{% set reboot_uptime_seconds = 600 %}
{# The offsite backup runs nightly; 36 hours tolerates one missed or overlong run before alerting. #}
{% set backup_max_age_seconds = 129600 %}
{# Mesh point backhaul. The thresholds were chosen by replaying the rules over the 40 days of data to
   2026-11-01, which held one bad episode: the Kitchen mesh point's backhaul fell from 5 GHz to 2.4 GHz on
   2026-10-16 and stayed there until a restart on 11-01, taking its mean round trip from 2 ms to 40-85 ms a
   day, every client behind it and on the router's 2.4 GHz radio with it, and nobody noticed for 16 days.
   Mean round trip above 20 ms over 30 minutes: never two windows in a row before the episode, sustained
   from 10-21. Three or more re-joins in an hour: only on 10-28 and 10-30, and single hours on three other
   days; above one in an hour fires on scattered single hours all through September. A 2.4 GHz backhaul
   for an hour: only the episode and the mesh's first day. #}
{% set mesh_point_rtt_mean_seconds = 0.02 %}
{% set mesh_point_rejoins_per_hour = 3 %}
groups:
  - name: collectors
    rules:
      - alert: CollectorDown
        expr: up == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Scrape target {{ L }} $labels.job {{ R }} ({{ L }} $labels.instance {{ R }}) is down"

      - alert: AirPlayProbeFailing
        expr: airplay_up == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "The AirPlay mDNS probe is not running (check MONITORING_LAN_IP and host networking)"

      # lan_discovery_up is 0 when the exporter could not load the device address inventory or could
      # not write the probe target files; a single address source failing does not clear it (that is
      # DeviceAddressSourceStale's business). While this fires the target files are frozen, so the
      # HomePod rules that depend on addresses go quiet rather than following stale ones.
      - alert: LanDiscoveryFailing
        expr: lan_discovery_up == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: >-
            The LAN discovery exporter cannot render the probe targets from the device address
            inventory; the ping and AirPlay target files are frozen until it recovers

      # The notification path itself: a rotated Slack token or a deleted Discord webhook would
      # otherwise turn every alert into a silent one. Two receivers means a failure of one is still
      # deliverable through the other.
      - alert: AlertmanagerNotificationsFailing
        expr: rate(alertmanager_notifications_failed_total[15m]) > 0
        labels:
          severity: critical
        annotations:
          summary: "Alertmanager cannot deliver to {{ L }} $labels.integration {{ R }}"

      - alert: PrometheusAlertmanagerUnreachable
        expr: prometheus_notifications_alertmanagers_discovered < 1
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Prometheus has no reachable Alertmanager; nothing is being delivered"

  - name: wan
    rules:
      # The WAN rules below compare against a series that must exist; if the ping target list ever
      # loses the anchor, they would all fall silent, so say so.
      - alert: WanProbeMissing
        expr: >-
          absent(ping_loss_ratio{target="{{ wan_target }}"})
          or absent(ping_rtt_mean_seconds{target="{{ wan_target }}"})
          or absent(ping_rtt_std_deviation_seconds{target="{{ wan_target }}"})
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "ping_exporter is not reporting the WAN probe target {{ wan_target }}"

      - alert: WanPacketLoss
        expr: >-
          avg_over_time(ping_loss_ratio{target="{{ wan_target }}"}[5m])
          > {{ wan_loss_ratio }}
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: >-
            WAN packet loss to {{ L }} $labels.target {{ R }} is {{ L }} $value | humanizePercentage {{ R }}

      - alert: WanLatencyHigh
        expr: >-
          ping_rtt_mean_seconds{target="{{ wan_target }}"}
          > {{ wan_latency_seconds }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: >-
            WAN round-trip to {{ L }} $labels.target {{ R }} is {{ L }} $value | humanizeDuration {{ R }}

      - alert: WanJitterHigh
        expr: >-
          ping_rtt_std_deviation_seconds{target="{{ wan_target }}"}
          > {{ wan_jitter_seconds }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "WAN jitter to {{ L }} $labels.target {{ R }} is {{ L }} $value | humanizeDuration {{ R }}"

  # The offsite_backups role writes these gauges through node_exporter's textfile collector.
  - name: backups
    rules:
      - alert: OffsiteBackupStale
        expr: >-
          time() - offsite_backups_last_success_timestamp_seconds
          > {{ backup_max_age_seconds }}
        labels:
          severity: critical
        annotations:
          summary: >-
            No successful offsite backup for
            {{ L }} $value | humanizeDuration {{ R }}

      - alert: OffsiteBackupFailed
        expr: offsite_backups_last_run_success == 0
        labels:
          severity: warning
        annotations:
          summary: "The last offsite backup attempt failed (restic exit code in the metrics file)"

      # The metrics file is missing or the textfile collector is not reading it.
      - alert: OffsiteBackupMetricsMissing
        expr: absent(offsite_backups_last_success_timestamp_seconds)
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "node_exporter is not reporting offsite backup metrics"
{% if monitoring_alerts_include_device_rules %}

  - name: homepods
    rules:
      # The ping and AirPlay probes drop a HomePod within one poll of it leaving the WiFi, so the
      # rules below cannot see that case; this one can.
      # This is the router's view alone, so it is blind while the AmpliFi scrape is down (the series
      # is cleared, and AmpliFiScrapeFailing says so); a HomePod gone from every address source is
      # TrackedDeviceAddressUnknown's business.
      - alert: HomePodNotOnWifi
        expr: amplifi_tracked_client_associated{kind="homepod"} == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "HomePod {{ L }} $labels.name {{ R }} is not associated with any access point"

      # The two rules below rest on probes aimed at addresses from the device address inventory, so
      # each also requires that the HomePod's address is fresh. By construction a HomePod with no fresh
      # address has no probe target and no series here, but the probe series outlive a withdrawn target
      # by a scrape or two, and if the LAN discovery exporter itself froze they would outlive it for
      # good, reporting a HomePod gone because its probes follow an address it no longer has. With the
      # guard, that failure makes these rules silent while LanDiscoveryFailing speaks.
      - alert: HomePodUnreachable
        expr: >-
          (ping_loss_ratio * on (ip) group_left (name, kind) monitoring_target_info{kind="homepod"}) == 1
          and on (name) device_address_fresh == 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "HomePod {{ L }} $labels.name {{ R }} ({{ L }} $labels.ip {{ R }}) is not answering ping"

      - alert: HomePodAirPlayPortDown
        expr: probe_success{job="airplay_tcp"} == 0 and on (name) device_address_fresh == 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "HomePod {{ L }} $labels.name {{ R }} is not accepting AirPlay connections"

      # Only both mDNS queries failing alerts: that is the AirPlay service itself being down.
      # Multicast failing on its own does not. It was an alert (HomePodAirPlayNotResolving) until
      # 2026-09-28, and fired for three or four HomePods at a time, most of the time, while every one
      # of them could be played to: that day three HomePods played a stream normally while failing it,
      # and all nine were listed in a phone's and a tablet's AirPlay choosers. The query comes from the
      # wired LAN, the worst case for the multicast path to a 5 GHz client, which the devices that
      # actually send AirPlay are not on. The gauge is still recorded and charted. The cost is a
      # HomePod that fails multicast while its address is unknown, so that unicast cannot be tried:
      # nothing here reports it, and if it is off the network `HomePodNotOnWifi` does. No freshness
      # guard is needed: the unicast gauge exists only for a HomePod whose address the inventory calls
      # fresh (and its `name` is the AirPlay name, which device_address_fresh does not carry).
      - alert: HomePodAirPlayServiceGone
        expr: >-
          airplay_service_unicast_resolved{service="_airplay._tcp"} == 0
          and on (name) airplay_service_resolved{service="_airplay._tcp"} == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: >-
            HomePod {{ L }} $labels.name {{ R }} answers neither multicast nor unicast AirPlay mDNS
            queries: its AirPlay service is down

      # A fault in the monitoring, not in the HomePod: the playback gauges are absent, not 0, for a
      # record that cannot be read, so without this nothing would say that they had gone. Apple does
      # not document the record, so a HomePod software update is the likely cause. The gauge is absent
      # for a poll the HomePod misses (about one an hour each, 2026-09-28), which would restart the
      # wait, so the last reading within two minutes stands in. A HomePod that stops answering has no
      # reading at all and is the mDNS rules' business.
      - alert: HomePodPlaybackStateUnreadable
        expr: last_over_time(airplay_playback_state_readable[2m]) == 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: >-
            HomePod {{ L }} $labels.name {{ R }} answers with an AirPlay record its playback state
            cannot be read from, so whether it is playing and which group it is in are unknown; the
            airplay exporter's log says what is wrong with the record

  - name: amplifi
    rules:
      - alert: AmpliFiRebooted
        expr: amplifi_router_uptime_seconds < {{ reboot_uptime_seconds }}
        labels:
          severity: info
        annotations:
          summary: "The AmpliFi router rebooted"

      - alert: MeshPointRebooted
        expr: amplifi_mesh_point_uptime_seconds < {{ reboot_uptime_seconds }}
        labels:
          severity: info
        annotations:
          summary: "Mesh point {{ L }} $labels.name {{ R }} rebooted"

      # The router keeps listing a mesh point it has lost, under "offline", so this is the usual form
      # of a dropped mesh point; MeshPointMissing below covers one that vanishes altogether.
      - alert: MeshPointOffline
        expr: amplifi_mesh_point_online == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Mesh point {{ L }} $labels.name {{ R }} is offline: the router lists it as lost from the mesh"

      # Every mesh point seen in the last week, minus those the router lists now, so the alert names
      # the missing one without a hard-coded list; after a week of absence it resolves on its own.
      - alert: MeshPointMissing
        expr: >-
          max_over_time(amplifi_mesh_point_online[7d]) unless on (mac) amplifi_mesh_point_online
          and on () amplifi_up == 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: >-
            Mesh point {{ L }} $labels.name {{ R }} is no longer in the router's topology at all,
            online or offline

      # The backhaul. A 2.4 GHz backhaul is slow and shares the router's 2.4 GHz radio with the HomePods,
      # so a mesh point on one degrades the whole 2.4 GHz band (2026-10-16 to 11-01, see the README);
      # restarting the mesh point from the AmpliFi app made it rejoin on 5 GHz. The round-trip rule
      # catches a backhaul that is slow for any other reason, including a daisy chain through a bad
      # link, and lagged the band change by five days in the one episode; the re-join rule catches a
      # backhaul that keeps dropping. Daisy-chaining (level 3) by itself is not alerted on: the Kitchen
      # mesh point hung off the Living Room one on 5 GHz from 2026-09-29 to 10-02 at 2-4 ms.
      - alert: MeshPointBackhaulOn24GHz
        expr: amplifi_mesh_point_info{backhaul_band="2.4 GHz"} == 1
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: >-
            Mesh point {{ L }} $labels.name {{ R }} has had a 2.4 GHz backhaul for an hour: slow for
            everything behind it and a load on the router's 2.4 GHz radio; restarting the mesh point
            from the AmpliFi app makes it pick its backhaul again

      - alert: MeshPointBackhaulSlow
        expr: >-
          (avg_over_time(ping_rtt_mean_seconds[30m])
            * on (ip) group_left (name, kind) monitoring_target_info{kind="mesh_point"})
          > {{ mesh_point_rtt_mean_seconds }}
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: >-
            Mesh point {{ L }} $labels.name {{ R }} has answered ping in
            {{ L }} $value | humanizeDuration {{ R }} on average for an hour, against about 2 ms when its
            backhaul is healthy

      - alert: MeshPointBackhaulFlapping
        expr: >-
          increase(amplifi_mesh_point_connections_total{direction="to"}[1h])
          > {{ mesh_point_rejoins_per_hour }}
        labels:
          severity: warning
        annotations:
          summary: >-
            Mesh point {{ L }} $labels.name {{ R }} re-joined the mesh
            {{ L }} $value | printf "%.0f" {{ R }} times in the last hour

      - alert: AmpliFiScrapeFailing
        expr: amplifi_up == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: >-
            The AmpliFi exporter cannot read the router: the WiFi association, signal and mesh series are
            gone and HomePodNotOnWifi is blind until it recovers; device addresses still come from mDNS
            and the neighbour table

  # The device address inventory (common/device_addresses.py in the exporters): where the probes learn
  # each tracked device's address, and what to say when they cannot.
  - name: addresses
    rules:
      # No source (router, mDNS, neighbour table) has seen the device's address within the freshness
      # window, so it is not being probed at all. Only for the kinds expected online at all times
      # (homepod, appletv, other_infra; the exporter sets the label from the kind): phones, tablets
      # and laptops sleep and rotate their addresses, and a device someone switched off is not an
      # incident.
      - alert: TrackedDeviceAddressUnknown
        expr: device_address_fresh{expect_online="1"} == 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: >-
            {{ L }} $labels.kind {{ R }} {{ L }} $labels.name {{ R }} has had no address from any source
            (router, mDNS, neighbour table) for the freshness window, so nothing is probing it

      # A producer that has stopped writing its file. The router source is left out: when it stops,
      # AmpliFiScrapeFailing already says so, and two notifications for one cause is noise. A source the
      # exporter is not running (no LAN subnet configured) never writes, which is not staleness.
      - alert: DeviceAddressSourceStale
        expr: >-
          (time() - device_address_source_last_write_timestamp_seconds{source=~"mdns|arp"} > 900)
          and on (source) device_address_source_enabled == 1
        labels:
          severity: warning
        annotations:
          summary: >-
            The {{ L }} $labels.source {{ R }} source of the device address inventory has not been
            written for 15 minutes

  - name: gateway
    rules:
      - alert: GatewayRebooted
        expr: gateway_uptime_seconds < {{ reboot_uptime_seconds }}
        labels:
          severity: info
        annotations:
          summary: "The Comcast gateway rebooted"

      - alert: GatewayInternetInactive
        expr: gateway_internet_active == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "The Comcast gateway reports the Internet connection as inactive"

      # The share of a channel's codewords that were uncorrectable over the window: the increase in the
      # uncorrectable counter over the increase in all three counters. They share the `channel` label
      # (and the parser blanks channel 1's three counts together), so the division pairs up one-to-one.
      # No zero-denominator guard is needed: the denominator contains the numerator, so the only zero
      # case is 0/0 = NaN, which the comparison drops. No `for`: the 15-minute window already smooths.
{% set docsis_uncorrectable_share_expr -%}
          increase(gateway_docsis_downstream_uncorrectable_codewords_total[15m])
          / (
            increase(gateway_docsis_downstream_unerrored_codewords_total[15m])
            + increase(gateway_docsis_downstream_correctable_codewords_total[15m])
            + increase(gateway_docsis_downstream_uncorrectable_codewords_total[15m])
          )
{%- endset %}
      - alert: DocsisUncorrectableCodewords
        expr: >-
          {{ docsis_uncorrectable_share_expr }}
          > {{ docsis_uncorrectable_share }}
        keep_firing_for: {{ docsis_keep_firing_for }}
        labels:
          severity: warning
        annotations:
          summary: >-
            Downstream channel {{ L }} $labels.channel {{ R }}:
            {{ L }} $value | humanizePercentage {{ R }} of its codewords were uncorrectable over 15m

      - alert: DocsisUncorrectableCodewordsSevere
        expr: >-
          {{ docsis_uncorrectable_share_expr }}
          > {{ docsis_uncorrectable_share_severe }}
        keep_firing_for: {{ docsis_keep_firing_for }}
        labels:
          severity: critical
        annotations:
          summary: >-
            Downstream channel {{ L }} $labels.channel {{ R }}:
            {{ L }} $value | humanizePercentage {{ R }} of its codewords were uncorrectable over 15m

      # Line conditions (tilt, ingress, a loose connector) move blocks of channels together, so SNR and
      # power alert once with a channel count rather than once per channel; the dashboard has the
      # per-channel view.
      - alert: DocsisSnrLow
        expr: count(gateway_docsis_downstream_snr_db < {{ docsis_snr_min_db }}) > 0
        for: 10m
        keep_firing_for: {{ docsis_keep_firing_for }}
        labels:
          severity: warning
        annotations:
          summary: >-
            {{ L }} $value {{ R }} downstream channel(s) have SNR below {{ docsis_snr_min_db }} dB

      - alert: DocsisPowerOutOfRange
        expr: >-
          count(
            gateway_docsis_downstream_power_dbmv > {{ docsis_power_max_dbmv }}
            or gateway_docsis_downstream_power_dbmv < {{ docsis_power_min_dbmv }}
          ) > 0
        for: 10m
        keep_firing_for: {{ docsis_keep_firing_for }}
        labels:
          severity: warning
        annotations:
          summary: >-
            {{ L }} $value {{ R }} downstream channel(s) have power outside
            {{ docsis_power_min_dbmv }}..+{{ docsis_power_max_dbmv }} dBmV

      - alert: GatewayScrapeFailing
        expr: gateway_up == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "The gateway exporter cannot read the Comcast gateway"
{% endif %}
