# Prometheus recording rules. Generated by Ansible; do not edit directly.
#
# Derived series that the dashboards read and that a future alert could use.

{# What these rest on. Each HomePod's AirPlay record says whether audio is playing and which group the
   HomePod is in; the airplay exporter reads it every poll (the field meanings, and the 2026-09-28
   observations behind them, are in the exporter's airplay/state.py). The first version of these rules
   inferred audio from the download rate instead. That was dropped on 2026-09-28: the router reported
   no byte counts for seven of the nine HomePods, two silent HomePods read 50 and 66 kbit/s while
   their group re-formed, and no rate shows which HomePods are grouped. The rate is still recorded,
   as a second view for the HomePods that have one. #}
groups:
  # Evaluated every 30 s, the same as the alert rules and the exporter's poll, so `offset 30s` below is
  # exactly one evaluation and one reading of the record.
  - name: homepod_audio
    interval: 30s
    rules:
      # 1 while audio is playing on the HomePod, 0 while it is not. A HomePod that misses one poll has
      # no sample for it (seen 2026-09-28: one query in forty minutes went unanswered, with the state
      # the same before and after), so the last reading within two minutes stands in.
      - record: homepod:audio_active
        expr: last_over_time(airplay_audio_playing[2m])

      # 1 at the one evaluation where audio stopped: a point event for dashboard annotations, not a
      # state. Only a HomePod that answered and said so counts; one that left the network has no
      # reading at all and is `HomePodNotOnWifi`'s business. `and` keeps the left-hand sample, so the
      # term whose value is 1 comes first.
      - record: homepod:audio_ended
        expr: >-
          (homepod:audio_active offset 30s == 1)
          and on (name) (homepod:audio_active == 0)

      # What the HomePod is doing, as one number for a state timeline: 0 idle on its own, 1 playing
      # its own stream (and leading any HomePods that follow it), 2 following another device with
      # nothing playing (a paused or stopped stream leaves the group in place), 3 following and playing.
      - record: homepod:session_state
        expr: homepod:audio_active + 2 * (1 - last_over_time(airplay_group_leader[2m]))

      # 1 at the one evaluation where a HomePod is no longer in a group that is still playing: either
      # it dropped out (seen 2026-09-28: one of eight went silent while the rest played on) or someone
      # moved it, which the record cannot tell apart. The HomePod must have answered this poll, so a
      # missed answer does not read as leaving; the cost is that a HomePod that misses a poll just as
      # it leaves is not marked. Recorded, not alerted, until a real incident says whether it needs one.
      - record: homepod:left_playing_group
        expr: >-
          (airplay_group_info offset 30s)
          unless on (name, group) airplay_group_info
          and on (name) airplay_group_info
          and on (group) (airplay_group_info * on (name) group_left () (airplay_audio_playing == 1))

      # Download rate per HomePod, where the router reports byte counts for it. Summed by name so the
      # series survives a roam, which restarts the router's per-association counters (the exporter
      # folds them into one series per client, but the sum costs nothing and keeps the rule correct if
      # that ever changes).
      - record: homepod:download_bits_per_second:rate1m
        expr: sum by (name) (rate(amplifi_client_rx_bytes_total{kind="homepod"}[1m])) * 8
