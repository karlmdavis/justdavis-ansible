---

##
# Defines the containers for the arr stack, used for media management.
#
# Reference: Derived from <https://github.com/Luctia/ezarr>, which also lists many other services that this
# stack does not run (Radarr, Lidarr, Readarr, Mylar3, Overseerr, Jackett, SABnzbd, ...).
##

name: arr_stack
services:
  # Manages TV shows.
  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    environment:
      - PUID={{ arr_suite_uid }}
      - PGID={{ media_managers_gid }}
      - UMASK={{ arr_suite_umask }}
      - TZ={{ arr_suite_timezone }}
    volumes:
      - {{ arr_suite_root_dir }}/config/sonarr-config:/config
      - /var/fileshares/{{ domain }}/groups:/data
    ports:
      - "127.0.0.1:8989:8989"
      - "{{ private_ip_address }}:8989:8989"
    restart: unless-stopped

  # A companion application to Sonarr and Radarr that manages and downloads subtitles based on your
  # requirements.
  bazarr:
    image: lscr.io/linuxserver/bazarr:latest
    container_name: bazarr
    environment:
      - PUID={{ arr_suite_uid }}
      - PGID={{ media_managers_gid }}
      - TZ={{ arr_suite_timezone }}
    volumes:
      - {{ arr_suite_root_dir }}/config/bazarr-config:/config
      - /var/fileshares/{{ domain }}/groups/media:/data/media
    ports:
      - "127.0.0.1:6767:6767"
      - "{{ private_ip_address }}:6767:6767"
    restart: unless-stopped

  # Keeps track of indexers and their status, as a companion to Sonarr, Radarr, etc.
  prowlarr:
    image: lscr.io/linuxserver/prowlarr:develop
    container_name: prowlarr
    environment:
      - PUID={{ arr_suite_uid }}
      - PGID={{ media_managers_gid }}
      - UMASK={{ arr_suite_umask }}
      - TZ={{ arr_suite_timezone }}
    volumes:
      - {{ arr_suite_root_dir }}/config/prowlarr-config:/config
    ports:
      - "127.0.0.1:9696:9696"
      - "{{ private_ip_address }}:9696:9696"
    restart: unless-stopped

  # Manages books: monitors wanted titles and authors, searches Prowlarr's indexers, sends grabs to
  # qBittorrent and imports the results into the ebooks folder. The replacement for Readarr, which was
  # retired in 2025; see README.md for why Bindery and how it is configured.
  bindery:
    image: ghcr.io/vavallee/bindery:{{ arr_suite_bindery_version }}
    container_name: bindery
    # Distroless image with no PUID/PGID entrypoint: the container runs as the arr_suite user directly, and
    # BINDERY_PUID/PGID only make Bindery refuse to start if that is not the user it is running as.
    user: "{{ arr_suite_uid }}:{{ media_managers_gid }}"
    environment:
      - BINDERY_PUID={{ arr_suite_uid }}
      - BINDERY_PGID={{ media_managers_gid }}
      - TZ={{ arr_suite_timezone }}
      # Served under the intranet vhost's /bindery like the other arr apps. Apache terminates TLS, and the
      # proxy's forwarded headers are not trusted by default, so the session cookie is marked Secure
      # unconditionally rather than "when the request looked like https".
      - BINDERY_URL_BASE=/bindery
      - BINDERY_COOKIE_SECURE=always
      # The same single /data mount as sonarr, with the same paths qbittorrent uses for its downloads, so
      # that imports hardlink instead of copying.
      - BINDERY_DOWNLOAD_DIR=/data/torrents
      - BINDERY_LIBRARY_DIR=/data/media/books/ebooks
      # The widest mode Bindery allows for folders it creates. It cannot make them group-writable like the
      # rest of the media tree (UMASK has no effect on it), so fixing permissions by hand later is expected.
      - BINDERY_DIR_MODE=0755
    volumes:
      - {{ arr_suite_root_dir }}/config/bindery-config:/config
      - /var/fileshares/{{ domain }}/groups:/data
    ports:
      - "127.0.0.1:8787:8787"
      - "{{ private_ip_address }}:8787:8787"
    restart: unless-stopped

  # A torrent client that can be used with Sonarr, Radarr, etc.
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    environment:
      - PUID={{ arr_suite_uid }}
      - PGID={{ media_managers_gid }}
      - UMASK={{ arr_suite_umask }}
      - TZ={{ arr_suite_timezone }}
      - WEBUI_PORT=8080
    volumes:
      - {{ arr_suite_root_dir }}/config/qbittorrent-config:/config
      - /var/fileshares/{{ domain }}/groups/torrents:/data/torrents
    ports:
      - "127.0.0.1:8080:8080"
      - "{{ private_ip_address }}:8080:8080"
      - "127.0.0.1:6881:6881"
      - "127.0.0.1:6881:6881/udp"
    restart: unless-stopped
