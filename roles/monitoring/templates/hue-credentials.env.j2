# The Hue bridge application key. Generated by Ansible - do not edit directly.
#
# Read by `docker compose` (as root) and handed only to the Hue scraper. A dummy value in the test
# environment, where the bridge does not exist. Compose's env-file parser expands `$VAR` in unquoted
# values, so a literal dollar sign must be written as `$$` (quoting is no help: a quote inside the
# value would end it). The key is created with the bridge's link button by
# roles/monitoring/scripts/hue_create_application_key.py.
HUE_APPLICATION_KEY={{ 'test-not-a-secret' if is_test else vault_hue_application_key | replace('$', '$$') }}
