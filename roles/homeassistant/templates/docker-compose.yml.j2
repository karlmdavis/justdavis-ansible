##

name: homeassistant

services:
  homeassistant:
    image: {{ homeassistant_image }}
    # Host networking: HomeKit and mDNS discovery need the LAN's multicast, and the HomeKit Bridge must
    # be reachable at the host's own address. ufw decides what the LAN can reach; see the README.
    network_mode: host
    # No capabilities and no privileged mode: nothing here uses Bluetooth, USB or raw sockets. The one
    # thing this costs is DHCP-based device discovery, which logs "Cannot watch for dhcp packets" once
    # at start.
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    volumes:
      - {{ homeassistant_base_dir }}/config:/config
      - /etc/localtime:/etc/localtime:ro
    mem_limit: {{ homeassistant_memory_limit }}
    stop_grace_period: 60s
    restart: unless-stopped
