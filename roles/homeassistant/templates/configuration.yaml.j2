# Home Assistant configuration. Generated by Ansible; do not edit directly.
#
# This file is the only part of Home Assistant's configuration that Ansible owns. Integrations,
# pairings, users, areas and helpers are created in the UI and stored by Home Assistant itself under
# `.storage`; see the role's README for the runbook.

default_config:

# Read on the very first start only: Home Assistant then moves its HTTP settings into its own storage
# and ignores this block (later changes are made under Settings > System > Network). It is here so
# that a new instance accepts requests through the Apache vhost from its first minute; without it a
# proxied request is answered 400.
http:
  use_x_forwarded_for: true
  trusted_proxies:
    - 127.0.0.1

# The metrics the monitoring role's Prometheus scrapes, at /api/prometheus. Whole domains only: naming
# entities here would put the household's device names into this repository.
prometheus:
{% if is_test %}
  # The test environment has no user to issue an access token; production requires one.
  requires_auth: false
{% endif %}
  filter:
    include_domains:
      - sensor
      - binary_sensor
      - climate
      - light
      - switch
      - update

# Days of state history kept for Home Assistant's own UI. Short, because Prometheus is where the
# history lives.
recorder:
  purge_keep_days: 3
