[Unit]
Description=Home Network Monitoring (Prometheus, Grafana, Alertmanager, exporters)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
WorkingDirectory={{ monitoring_base_dir }}
Type=simple
# No --build/--pull here on purpose: images are built and pulled by Ansible handlers during deploys, so
# a restart during a WAN outage (exactly when this stack matters most) depends on nothing remote.
#
# Always tear the stack down before bringing it up: a restart of a failed unit skips ExecStop, and
# `compose up` alone does not recreate a container whose mounted config files changed. The leading
# "-" makes a failed teardown (e.g. nothing running) non-fatal.
ExecStartPre=-/usr/bin/docker compose down --remove-orphans
ExecStart=/usr/bin/docker compose up --remove-orphans
ExecStop=/usr/bin/docker compose down --remove-orphans
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
