[Unit]
Description=Run jellyfin-db-dump.service daily, before the offsite backup.

[Timer]
# Host time, which is UTC on eddings (late evening in the Eastern US). The offsite backup starts at 03:00 UTC
# (plus up to 30 minutes); this leaves the copy fresh for it.
OnCalendar=*-*-* 02:00:00
Persistent=true

[Install]
WantedBy=timers.target
