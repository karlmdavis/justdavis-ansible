# Credentials for the AmpliFi router and the Comcast gateway.
# Generated by Ansible - do not edit directly.
#
# Read by `docker compose` (as root) and handed only to the two device scrapers; the host-network
# AirPlay probe never sees them. Dummy values in the test environment, where the devices do not exist.
AMPLIFI_PASSWORD={{ 'test-not-a-secret' if is_test else vault_amplifi_password }}
GATEWAY_USERNAME={{ 'test-not-a-secret' if is_test else vault_gateway_username }}
GATEWAY_PASSWORD={{ 'test-not-a-secret' if is_test else vault_gateway_password }}
