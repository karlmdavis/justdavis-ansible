# Monitoring stack environment.
# Generated by Ansible - do not edit directly.
#
# Read by `docker compose` (as root) and handed to the three exporter containers only. Secrets
# below are dummy values in the test environment, where the devices do not exist anyway.

# Device hosts. Blank means "not configured": the exporter serves <name>_up 0 and idles.
MONITORING_AMPLIFI_HOST={{ '' if is_test else monitoring_amplifi_host }}
MONITORING_GATEWAY_HOST={{ '' if is_test else monitoring_gateway_host }}
MONITORING_LAN_IP={{ '' if is_test else private_ip_address }}

# Credentials.
AMPLIFI_PASSWORD={{ 'test-not-a-secret' if is_test else vault_amplifi_password }}
GATEWAY_USERNAME={{ 'test-not-a-secret' if is_test else vault_gateway_username }}
GATEWAY_PASSWORD={{ 'test-not-a-secret' if is_test else vault_gateway_password }}
{# Blank when the gateway is not configured; set from the certificate fetched at deploy time. #}
MONITORING_GATEWAY_TLS_FINGERPRINT_SHA256={{ monitoring_gateway_tls_fingerprint | default("") | trim }}

# Polling.
MONITORING_AMPLIFI_INTERVAL={{ monitoring_amplifi_interval_seconds }}
MONITORING_GATEWAY_INTERVAL={{ monitoring_gateway_interval_seconds }}
MONITORING_GATEWAY_RELOGIN_MIN_SECONDS={{ monitoring_gateway_relogin_min_seconds }}
MONITORING_AIRPLAY_INTERVAL={{ monitoring_airplay_interval_seconds }}
MONITORING_AIRPLAY_RESOLVE_TIMEOUT_MS={{ monitoring_airplay_resolve_timeout_ms }}
MONITORING_PING_INTERVAL={{ monitoring_ping_interval_seconds }}
MONITORING_PING_TIMEOUT={{ monitoring_ping_timeout_seconds }}
MONITORING_PING_HISTORY_SIZE={{ monitoring_ping_history_size }}

# Targets.
MONITORING_TRACKED_CLIENTS={{ ([] if is_test else monitoring_tracked_clients) | to_json }}
MONITORING_STATIC_PING_TARGETS={{ monitoring_static_ping_targets | to_json }}
MONITORING_SHARED_DIR=/shared
MONITORING_LOG_LEVEL=INFO
