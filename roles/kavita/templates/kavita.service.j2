[Unit]
Description=Kavita Reading Server
Requires=docker.service
After=docker.service

[Service]
WorkingDirectory={{ kavita_base_dir }}
Type=simple
ExecStart=/usr/bin/docker compose up --pull always --force-recreate
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
