# Prometheus alert rules. Generated by Ansible; do not edit directly.
#
# Thresholds are set at the top of the template (roles/monitoring/templates/alerts.yml.j2) with the
# guidance they follow. Device-specific rule groups are omitted in the test environment, where the
# devices do not exist and would all be "down".

{# Go template delimiters, spelled via variables because Ansible's Jinja trims the newline after
   an inline raw block. #}
{% set L = '{{' %}
{% set R = '}}' %}
{# The ping target whose loss, latency, and jitter stand for "the internet". #}
{% set wan_target = '1.1.1.1' %}
{# Video-conferencing guidance: calls degrade above roughly 5% loss, 100 ms round trip, 30 ms jitter. #}
{% set wan_loss_ratio = 0.05 %}
{% set wan_latency_seconds = 0.1 %}
{% set wan_jitter_seconds = 0.03 %}
{# DOCSIS guidance: SNR below 33 dB is a line problem, and the rule uses that figure as is. Downstream
   power has two figures: the ideal range is -7..+7 dBmV, and the receiver's specified input range is
   -15..+15 dBmV. This plant reads +10 to +13.5 dBmV (September 2026; hottest on the 381-441 MHz
   channels, ~1.5 dB higher overnight than by day), i.e. 3 to 6.5 dB above the ideal ceiling, with
   43-45 dB SNR and no uncorrectable codewords, so the excess costs nothing measurable. The rule
   therefore alerts at the spec limit, and the gap to the ideal is a data point for a call to Comcast,
   not an alert. #}
{% set docsis_snr_min_db = 33 %}
{% set docsis_power_min_dbmv = -15 %}
{% set docsis_power_max_dbmv = 15 %}
{% set docsis_uncorrectable_increase_15m = 1000 %}
{# Single gateway scrapes fail a few times a day (the page not arriving within the exporter's 15 s
   read timeout, or arriving half-rendered), and each failure leaves a two-to-three-minute hole in
   every DOCSIS series while the exporter backs off. A hole resets a rule's `for` clock, so the channel
   rules keep firing across one instead of resolving and re-firing. #}
{% set docsis_keep_firing_for = '15m' %}
{# Uptime below this means the device rebooted in the last ten minutes: long enough for the rule to be
   evaluated and the alert delivered, short enough that it does not linger. #}
{% set reboot_uptime_seconds = 600 %}
{# The offsite backup runs nightly; 36 hours tolerates one missed or overlong run before alerting. #}
{% set backup_max_age_seconds = 129600 %}
groups:
  - name: collectors
    rules:
      - alert: CollectorDown
        expr: up == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Scrape target {{ L }} $labels.job {{ R }} ({{ L }} $labels.instance {{ R }}) is down"

      - alert: AirPlayProbeFailing
        expr: airplay_up == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "The AirPlay mDNS probe is not running (check MONITORING_LAN_IP and host networking)"

      # The notification path itself: a rotated Slack token or a deleted Discord webhook would
      # otherwise turn every alert into a silent one. Two receivers means a failure of one is still
      # deliverable through the other.
      - alert: AlertmanagerNotificationsFailing
        expr: rate(alertmanager_notifications_failed_total[15m]) > 0
        labels:
          severity: critical
        annotations:
          summary: "Alertmanager cannot deliver to {{ L }} $labels.integration {{ R }}"

      - alert: PrometheusAlertmanagerUnreachable
        expr: prometheus_notifications_alertmanagers_discovered < 1
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Prometheus has no reachable Alertmanager; nothing is being delivered"

  - name: wan
    rules:
      # The WAN rules below compare against a series that must exist; if the ping target list ever
      # loses the anchor, they would all fall silent, so say so.
      - alert: WanProbeMissing
        expr: >-
          absent(ping_loss_ratio{target="{{ wan_target }}"})
          or absent(ping_rtt_mean_seconds{target="{{ wan_target }}"})
          or absent(ping_rtt_std_deviation_seconds{target="{{ wan_target }}"})
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "ping_exporter is not reporting the WAN probe target {{ wan_target }}"

      - alert: WanPacketLoss
        expr: >-
          avg_over_time(ping_loss_ratio{target="{{ wan_target }}"}[5m])
          > {{ wan_loss_ratio }}
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: >-
            WAN packet loss to {{ L }} $labels.target {{ R }} is {{ L }} $value | humanizePercentage {{ R }}

      - alert: WanLatencyHigh
        expr: >-
          ping_rtt_mean_seconds{target="{{ wan_target }}"}
          > {{ wan_latency_seconds }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: >-
            WAN round-trip to {{ L }} $labels.target {{ R }} is {{ L }} $value | humanizeDuration {{ R }}

      - alert: WanJitterHigh
        expr: >-
          ping_rtt_std_deviation_seconds{target="{{ wan_target }}"}
          > {{ wan_jitter_seconds }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "WAN jitter to {{ L }} $labels.target {{ R }} is {{ L }} $value | humanizeDuration {{ R }}"

  # The offsite_backups role writes these gauges through node_exporter's textfile collector.
  - name: backups
    rules:
      - alert: OffsiteBackupStale
        expr: >-
          time() - offsite_backups_last_success_timestamp_seconds
          > {{ backup_max_age_seconds }}
        labels:
          severity: critical
        annotations:
          summary: >-
            No successful offsite backup for
            {{ L }} $value | humanizeDuration {{ R }}

      - alert: OffsiteBackupFailed
        expr: offsite_backups_last_run_success == 0
        labels:
          severity: warning
        annotations:
          summary: "The last offsite backup attempt failed (restic exit code in the metrics file)"

      # The metrics file is missing or the textfile collector is not reading it.
      - alert: OffsiteBackupMetricsMissing
        expr: absent(offsite_backups_last_success_timestamp_seconds)
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "node_exporter is not reporting offsite backup metrics"
{% if not is_test %}

  - name: homepods
    rules:
      # The ping and AirPlay probes drop a HomePod within one poll of it leaving the WiFi, so the
      # rules below cannot see that case; this one can.
      - alert: HomePodNotOnWifi
        expr: amplifi_tracked_client_associated{kind="homepod"} == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "HomePod {{ L }} $labels.name {{ R }} is not associated with any access point"

      - alert: HomePodUnreachable
        expr: >-
          (ping_loss_ratio * on (ip) group_left (name, kind) monitoring_target_info{kind="homepod"}) == 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "HomePod {{ L }} $labels.name {{ R }} ({{ L }} $labels.ip {{ R }}) is not answering ping"

      - alert: HomePodAirPlayPortDown
        expr: probe_success{job="airplay_tcp"} == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "HomePod {{ L }} $labels.name {{ R }} is not accepting AirPlay connections"

      - alert: HomePodAirPlayNotResolving
        expr: airplay_service_resolved{service="_airplay._tcp"} == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "HomePod {{ L }} $labels.name {{ R }} does not answer AirPlay mDNS queries"

  - name: amplifi
    rules:
      - alert: AmpliFiRebooted
        expr: amplifi_router_uptime_seconds < {{ reboot_uptime_seconds }}
        labels:
          severity: info
        annotations:
          summary: "The AmpliFi router rebooted"

      - alert: MeshPointRebooted
        expr: amplifi_mesh_point_uptime_seconds < {{ reboot_uptime_seconds }}
        labels:
          severity: info
        annotations:
          summary: "Mesh point {{ L }} $labels.name {{ R }} rebooted"

      # The router keeps listing a mesh point it has lost, under "offline", so this is the usual form
      # of a dropped mesh point; MeshPointMissing below covers one that vanishes altogether.
      - alert: MeshPointOffline
        expr: amplifi_mesh_point_online == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Mesh point {{ L }} $labels.name {{ R }} is offline: the router lists it as lost from the mesh"

      # Every mesh point seen in the last week, minus those the router lists now, so the alert names
      # the missing one without a hard-coded list; after a week of absence it resolves on its own.
      - alert: MeshPointMissing
        expr: >-
          max_over_time(amplifi_mesh_point_online[7d]) unless on (mac) amplifi_mesh_point_online
          and on () amplifi_up == 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: >-
            Mesh point {{ L }} $labels.name {{ R }} is no longer in the router's topology at all,
            online or offline

      - alert: AmpliFiScrapeFailing
        expr: amplifi_up == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "The AmpliFi exporter cannot read the router"

      # The exporter keeps polling when it cannot rewrite the shared target files, but the ping and
      # AirPlay probes then keep following stale HomePod addresses.
      - alert: AmpliFiTargetFilesNotWritable
        expr: amplifi_target_files_ok == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "The AmpliFi exporter cannot write the ping/AirPlay target files in /shared"

  - name: gateway
    rules:
      - alert: GatewayRebooted
        expr: gateway_uptime_seconds < {{ reboot_uptime_seconds }}
        labels:
          severity: info
        annotations:
          summary: "The Comcast gateway rebooted"

      - alert: GatewayInternetInactive
        expr: gateway_internet_active == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "The Comcast gateway reports the Internet connection as inactive"

      - alert: DocsisUncorrectableCodewords
        expr: rate(gateway_docsis_downstream_uncorrectable_codewords_total[5m]) > 0
        for: 5m
        keep_firing_for: {{ docsis_keep_firing_for }}
        labels:
          severity: warning
        annotations:
          summary: "Downstream channel {{ L }} $labels.channel {{ R }} is seeing uncorrectable codewords"

      - alert: DocsisUncorrectableCodewordsBurst
        expr: >-
          increase(gateway_docsis_downstream_uncorrectable_codewords_total[15m])
          > {{ docsis_uncorrectable_increase_15m }}
        labels:
          severity: critical
        annotations:
          summary: >-
            Downstream channel {{ L }} $labels.channel {{ R }}: {{ L }} $value | humanize {{ R }}
            uncorrectable codewords in 15m

      # Line conditions (tilt, ingress, a loose connector) move blocks of channels together, so SNR and
      # power alert once with a channel count rather than once per channel; the dashboard has the
      # per-channel view.
      - alert: DocsisSnrLow
        expr: count(gateway_docsis_downstream_snr_db < {{ docsis_snr_min_db }}) > 0
        for: 10m
        keep_firing_for: {{ docsis_keep_firing_for }}
        labels:
          severity: warning
        annotations:
          summary: >-
            {{ L }} $value {{ R }} downstream channel(s) have SNR below {{ docsis_snr_min_db }} dB

      - alert: DocsisPowerOutOfRange
        expr: >-
          count(
            gateway_docsis_downstream_power_dbmv > {{ docsis_power_max_dbmv }}
            or gateway_docsis_downstream_power_dbmv < {{ docsis_power_min_dbmv }}
          ) > 0
        for: 10m
        keep_firing_for: {{ docsis_keep_firing_for }}
        labels:
          severity: warning
        annotations:
          summary: >-
            {{ L }} $value {{ R }} downstream channel(s) have power outside
            {{ docsis_power_min_dbmv }}..+{{ docsis_power_max_dbmv }} dBmV

      - alert: GatewayScrapeFailing
        expr: gateway_up == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "The gateway exporter cannot read the Comcast gateway"
{% endif %}
