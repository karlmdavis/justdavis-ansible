# Ignore external roles.
roles_external/

# Ignore IDE metadata.
.project
justdavis-ansible.git.code-workspace

# Ignore the Ansible Vault password file.
vault.password

# Ignore Ansible's temp files.
*.retry
.ansible/

# Ignore the test data and host inventory.
test/hosts-test
test/user-config.env
test/test-session.env

# Ignore vim swp files.
*.swp

# Ignore Claude AI local settings
.claude/settings.local.json

# Ignore Python build artifacts.
*.egg-info/

# Python virtual environment (uv-managed)
/.venv/

# Git worktrees.
.worktrees/
.claude/worktrees/

# Ignore Python tooling caches anywhere (e.g. the exporter package under roles/monitoring).
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
