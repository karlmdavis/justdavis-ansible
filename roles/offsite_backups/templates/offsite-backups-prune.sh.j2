#!/bin/bash
##
# Weekly retention: forget snapshots outside the keep policy and prune the data they referenced.
# Managed by Ansible (roles/offsite_backups).
##
set -euo pipefail
echo "Offsite backup prune: applying retention policy..."
/usr/bin/restic forget \
  --host "$(hostname --short)" \
  --keep-daily {{ offsite_backups_keep_daily }} \
  --keep-weekly {{ offsite_backups_keep_weekly }} \
  --keep-monthly {{ offsite_backups_keep_monthly }} \
  --prune
echo "Offsite backup prune: completed."
